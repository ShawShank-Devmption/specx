{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specx.dev/contracts/verdict.schema.json",
  "title": "Verdict",
  "description": "Result of one sandbox invoke (single, concurrent or replay). Produced by Dev A's sandbox. This record IS the S2 training label and the S1 reward source; S6 fills `anomaly`. One line per run in results/verdicts/*.jsonl.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "session_id",
    "app",
    "tool_id",
    "args",
    "mode",
    "started_at",
    "duration_ms",
    "status",
    "clause_results",
    "effect_diff",
    "violations",
    "source"
  ],
  "properties": {
    "run_id": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "app": {
      "type": "string"
    },
    "tool_id": {
      "type": "string"
    },
    "tool_version": {
      "type": "integer"
    },
    "metadata_revision": {
      "type": "integer"
    },
    "args": {
      "type": "object"
    },
    "mode": {
      "type": "string",
      "enum": [
        "single",
        "concurrent",
        "replay"
      ]
    },
    "concurrency_group": {
      "type": "string",
      "description": "Shared by all runs launched by one invoke_concurrent call."
    },
    "sequence_prefix": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "tool_ids invoked earlier in this session, oldest first. S2 uses this as path context."
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_ms": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "error",
        "unverifiable"
      ],
      "description": "pass: all clauses hold · fail: ≥1 clause violated · error: handler threw / timed out · unverifiable: a clause could not be evaluated."
    },
    "output": {
      "description": "Handler return value (any JSON)."
    },
    "clause_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "clause_id",
          "kind",
          "surface",
          "passed"
        ],
        "properties": {
          "clause_id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "surface": {
            "type": "string"
          },
          "passed": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "null = could not evaluate (unverifiable)."
          },
          "observed": {},
          "expected": {},
          "message": {
            "type": "string"
          }
        }
      }
    },
    "effect_diff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "db",
        "network",
        "dom",
        "storage",
        "audit"
      ],
      "properties": {
        "db": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "inserted",
              "updated",
              "deleted"
            ],
            "properties": {
              "inserted": {
                "type": "integer"
              },
              "updated": {
                "type": "integer"
              },
              "deleted": {
                "type": "integer"
              }
            }
          },
          "description": "Keyed by table name."
        },
        "network": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "method",
              "url",
              "approved",
              "third_party"
            ],
            "properties": {
              "method": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "status": {
                "type": "integer"
              },
              "approved": {
                "type": "boolean"
              },
              "third_party": {
                "type": "boolean"
              },
              "phase": {
                "type": "string"
              }
            }
          }
        },
        "dom": {
          "type": "object",
          "required": [
            "mutations"
          ],
          "properties": {
            "mutations": {
              "type": "integer"
            },
            "added_selectors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "removed_selectors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "url_before": {
              "type": "string"
            },
            "url_after": {
              "type": "string"
            }
          }
        },
        "storage": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "area",
              "op",
              "key"
            ],
            "properties": {
              "area": {
                "type": "string"
              },
              "op": {
                "type": "string"
              },
              "key": {
                "type": "string"
              }
            }
          }
        },
        "audit": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "event",
              "count"
            ],
            "properties": {
              "event": {
                "type": "string"
              },
              "count": {
                "type": "integer"
              }
            }
          }
        }
      }
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "clause_id",
          "severity",
          "signature"
        ],
        "properties": {
          "clause_id": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "signature": {
            "type": "string",
            "description": "Stable dedup key: `${tool_id}|${clause_id}|${kind}|${normalised_observed}`. S1 reward = +1 per NEW signature in an episode."
          },
          "category": {
            "type": "string",
            "enum": [
              "precondition",
              "postcondition",
              "side_effect",
              "race",
              "unapproved_endpoint",
              "third_party",
              "storage",
              "anomaly"
            ]
          }
        }
      }
    },
    "anomaly": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "iforest_score",
        "lstm_error",
        "flagged"
      ],
      "properties": {
        "iforest_score": {
          "type": [
            "number",
            "null"
          ]
        },
        "lstm_error": {
          "type": [
            "number",
            "null"
          ]
        },
        "flagged": {
          "type": "boolean"
        },
        "flagged_windows": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      },
      "description": "Filled by Dev B's S6 scorer (specx.safety.s6.score_run). null until scored."
    },
    "source": {
      "type": "string",
      "enum": [
        "f1",
        "s1",
        "s1_random",
        "s1_coverage",
        "s6_approved",
        "s6_inject",
        "f2",
        "f4",
        "fixture",
        "mcp"
      ]
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "screenshot_path": {
          "type": "string"
        },
        "events_path": {
          "type": "string",
          "description": "JSONL of EventRecord for this run."
        },
        "dom_diff_path": {
          "type": "string"
        }
      }
    }
  }
}
