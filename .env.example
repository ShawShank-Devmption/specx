# Copy to .env (never commit .env). The Anthropic SDK reads ANTHROPIC_API_KEY automatically.
ANTHROPIC_API_KEY=sk-ant-...
# Frozen evaluation agent (F4/F2 trials). Do not change mid-experiment.
SPECX_AGENT_MODEL=claude-sonnet-5-5
# Generator (F3 naming/descriptions), reviser (F2) and S4 patch generator.
SPECX_GEN_MODEL=claude-opus-5-5
SPECX_SANDBOX_URL=http://127.0.0.1:4000
SPECX_RESULTS_DIR=results
