{
  "app": "admin",
  "port": 5102,
  "base_url": "http://127.0.0.1:5102",
  "start_cmd": "node seed-apps/admin/server.js",
  "home_path": "/users",
  "approved_hosts": ["127.0.0.1:5102", "localhost:5102"],
  "approved_endpoints": [
    { "method": "GET", "path": "/api/users", "risk_level": "read" },
    { "method": "GET", "path": "/api/users/:id", "risk_level": "read" },
    { "method": "POST", "path": "/api/users", "risk_level": "write" },
    { "method": "PATCH", "path": "/api/users/:id", "risk_level": "write" },
    { "method": "POST", "path": "/api/users/:id/role", "risk_level": "write" },
    { "method": "POST", "path": "/api/users/:id/deactivate", "risk_level": "write" },
    { "method": "DELETE", "path": "/api/users/:id", "risk_level": "delete" },
    { "method": "POST", "path": "/api/login", "risk_level": "write" }
  ],
  "auth": { "login_path": "/login", "username": "root", "password": "root123" },
  "tables": ["users", "notes", "audit_log"],
  "audit_table": "audit_log",
  "invariants": [
    { "id": "inv_active_admin", "kind": "db_row_exists", "table": "users", "where": { "role": "admin", "active": 1 }, "severity": "high", "description": "At least one active admin always exists" }
  ]
}
